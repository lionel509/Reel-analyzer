# Copy to .env and fill in. Only OPENROUTER_API_KEY is required.

# --- Required -------------------------------------------------------------
OPENROUTER_API_KEY=

# --- Models ---------------------------------------------------------------
# Leg A (words out). Note: openai/whisper-1 and gpt-4o-mini-transcribe both 403
# on OpenRouter — whisper-large-v3 is the one that serves.
TRANSCRIPTION_MODEL=openai/whisper-large-v3
# Leg B (watch it). Bump to google/gemma-4-31b-it if captions read poorly.
VISION_MODEL=google/gemma-4-26b-a4b-it

# --- Feed mode ------------------------------------------------------------
# frames = extract our own frames at scene cuts + a uniform floor (default, denser)
# video  = send the whole clip; the model samples it internally at ~1fps, 60s max
FEED_MODE=frames

# --- Frame sampling -------------------------------------------------------
SCENE_THRESHOLD=0.3      # ffmpeg scene score for a hard cut (0-1, lower = more frames)
UNIFORM_FPS=2.0          # steady floor so mid-scene caption changes are caught
FRAME_MIN_GAP=0.4        # seconds; collapses a scene cut and a uniform tick landing together
MAX_FRAMES=40            # hard cap; the run notes when it bites
FRAME_LONG_EDGE=768      # downscale before encoding, to bound tokens
FRAME_QUALITY=3          # ffmpeg -q:v, 2 (best) to 31 (worst)

# --- Guards and timeouts (seconds) ---------------------------------------
MAX_DURATION_SECONDS=900
AUDIO_TIMEOUT=120
VISION_TIMEOUT=240
DOWNLOAD_TIMEOUT=300
MAX_RETRIES=4

# --- Platform access ------------------------------------------------------
# Netscape-format cookies export from a logged-in browser, for private or
# rate-limited Instagram reels.
INSTAGRAM_COOKIES_FILE=

# --- Dashboard labelling (optional) --------------------------------------
OPENROUTER_REFERER=
OPENROUTER_TITLE=reel-analyzer
